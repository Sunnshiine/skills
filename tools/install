#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: tools/install [--launchd] | tools/install --clean [--yes]" >&2
  exit 2
}

clean=0
yes=0
launchd=0
for arg in "$@"; do
  case "$arg" in
    --clean) clean=1 ;;
    --yes) yes=1 ;;
    --launchd) launchd=1 ;;
    *) usage ;;
  esac
done
[ "$yes" = 0 ] || [ "$clean" = 1 ] || usage

repo=$(cd "$(dirname "$0")/.." && pwd -P)
manifest="$HOME/.agents/.skills-repo-managed"
CODEX_HEADER="# Generated by tools/install from the skills repo. Edits are overwritten."
BLOCK_BEGIN="<!-- BEGIN skills repo global instructions (managed by tools/install) -->"
BLOCK_END="<!-- END skills repo global instructions -->"
LABEL=com.sunnshiine.skills-sync

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

warn() { echo "warning: $*" >&2; }
managed() { [ -f "$manifest" ] && grep -qxF "$1" "$manifest"; }
present() { [ -e "$1" ] || [ -L "$1" ]; }

# Prints "<kind>\t<target>\t<source>" for every path install manages.
desired() {
  local d f n
  for d in "$repo"/skills/*/; do
    [ -d "$d" ] || continue
    n=$(basename "$d")
    printf 'link\t%s\t%s\n' "$HOME/.agents/skills/$n" "$repo/skills/$n"
    printf 'link\t%s\t%s\n' "$HOME/.claude/skills/$n" "$HOME/.agents/skills/$n"
  done
  for f in "$repo"/agents/*.md; do
    [ -f "$f" ] || continue
    n=$(basename "$f" .md)
    printf 'link\t%s\t%s\n' "$HOME/.claude/agents/$n.md" "$f"
    printf 'codex\t%s\t%s\n' "$HOME/.codex/agents/$n.toml" "$f"
  done
  printf 'link\t%s\t%s\n' "$HOME/.agents/pstack-models.md" "$repo/config/pstack-models.md"
}
desired >"$tmp/desired"
cut -f2 "$tmp/desired" >"$tmp/targets"

# A desired symlink that already points at its source is ours even without a manifest entry.
in_place() { awk -F'\t' -v t="$1" -v s="$2" '$1 == "link" && $2 == t && $3 == s { f = 1 } END { exit !f }' "$tmp/desired"; }

frontmatter_value() {
  local v
  v=$(awk -v k="$2" '
    NR == 1 && $0 == "---" { fm = 1; next }
    fm && $0 == "---" { exit }
    fm && index($0, k ":") == 1 { v = substr($0, length(k) + 2); sub(/^[ \t]+/, "", v); sub(/[ \t\r]+$/, "", v); print v; exit }
  ' "$1")
  case "$v" in
    \"*\") v=${v#\"}; v=${v%\"}; v=$(printf '%s' "$v" | sed -e 's/\\"/"/g' -e 's/\\\\/\\/g') ;;
    \'*\') v=${v#\'}; v=${v%\'}; v=${v//\'\'/\'} ;;
  esac
  printf '%s' "$v"
}

frontmatter_body() {
  awk 'NR == 1 && $0 == "---" { fm = 1; next } fm == 1 { if ($0 == "---") fm = 2; next } { print }' "$1" |
    tr -d '\r' |
    awk '{ l[NR] = $0 } END { s = 1; while (s <= NR && l[s] ~ /^[ \t]*$/) s++; e = NR; while (e >= s && l[e] ~ /^[ \t]*$/) e--; for (i = s; i <= e; i++) print l[i] }'
}

toml_escape() { sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

# Field mapping follows codex's external-agent-migration (subagents.rs); `model` is left out on purpose.
render_codex_agent() {
  local md=$1 name description effort permission sandbox="" body
  name=$(frontmatter_value "$md" name)
  description=$(frontmatter_value "$md" description)
  body=$(frontmatter_body "$md")
  [ -n "$name" ] && [ -n "$description" ] && [ -n "$body" ] || return 1
  effort=$(frontmatter_value "$md" effort)
  [ "$effort" = max ] && effort=xhigh
  case "$effort" in none | minimal | low | medium | high | xhigh) ;; *) effort="" ;; esac
  permission=$(frontmatter_value "$md" permissionMode)
  case "$permission" in
    acceptEdits) sandbox=workspace-write ;;
    readOnly) sandbox=read-only ;;
  esac
  echo "$CODEX_HEADER"
  printf 'name = "%s"\n' "$(printf '%s' "$name" | toml_escape)"
  printf 'description = "%s"\n' "$(printf '%s' "$description" | toml_escape)"
  if [ -n "$effort" ]; then printf 'model_reasoning_effort = "%s"\n' "$effort"; fi
  if [ -n "$sandbox" ]; then printf 'sandbox_mode = "%s"\n' "$sandbox"; fi
  printf 'developer_instructions = """\n%s"""\n' "$(printf '%s' "$body" | toml_escape)"
}

install_links() {
  local kind target src t
  : >"$tmp/manifest"
  while IFS=$'\t' read -r kind target src; do
    mkdir -p "$(dirname "$target")"
    case "$kind" in
      link)
        if [ -L "$target" ] && [ "$(readlink "$target")" = "$src" ]; then
          :
        elif present "$target" && ! managed "$target"; then
          warn "skipping $target: it exists and this repo does not manage it (tools/install --clean replaces it)"
          continue
        elif [ -d "$target" ] && [ ! -L "$target" ]; then
          warn "skipping $target: a directory replaced the link this repo manages"
          continue
        else
          rm -f "$target"
          ln -s "$src" "$target"
        fi
        ;;
      codex)
        if ! render_codex_agent "$src" >"$tmp/agent.toml"; then
          warn "skipping $target: $src needs a name, a description, and a body"
          continue
        fi
        if present "$target" && ! managed "$target"; then
          warn "skipping $target: it exists and this repo does not manage it (tools/install --clean replaces it)"
          continue
        fi
        cmp -s "$tmp/agent.toml" "$target" || cp "$tmp/agent.toml" "$target"
        ;;
    esac
    echo "$target" >>"$tmp/manifest"
  done <"$tmp/desired"

  if [ -f "$manifest" ]; then
    while IFS= read -r t; do
      grep -qxF "$t" "$tmp/manifest" && continue
      if [ -L "$t" ] || { [ -f "$t" ] && [ "$(head -n 1 "$t")" = "$CODEX_HEADER" ]; }; then
        rm -f "$t"
        echo "removed $t"
      fi
    done <"$manifest"
  fi
  mkdir -p "$(dirname "$manifest")"
  mv "$tmp/manifest" "$manifest"
}

install_instructions() {
  local claude_md="$HOME/.claude/CLAUDE.md" codex_md="$HOME/.codex/AGENTS.md"
  local line="@$repo/config/global-instructions.md"
  mkdir -p "$HOME/.claude" "$HOME/.codex"
  if ! grep -qxF "$line" "$claude_md" 2>/dev/null; then
    if [ -s "$claude_md" ]; then printf '\n' >>"$claude_md"; fi
    echo "$line" >>"$claude_md"
  fi

  { echo "$BLOCK_BEGIN"; cat "$repo/config/global-instructions.md"; echo "$BLOCK_END"; } >"$tmp/block"
  if [ -f "$codex_md" ] && grep -qxF "$BLOCK_BEGIN" "$codex_md"; then
    awk -v b="$BLOCK_BEGIN" -v e="$BLOCK_END" -v blk="$tmp/block" '
      $0 == b { while ((getline l < blk) > 0) print l; skip = 1; next }
      $0 == e { skip = 0; next }
      !skip { print }
    ' "$codex_md" >"$tmp/agents.md"
    cmp -s "$tmp/agents.md" "$codex_md" || cp "$tmp/agents.md" "$codex_md"
  else
    if [ -s "$codex_md" ]; then printf '\n' >>"$codex_md"; fi
    cat "$tmp/block" >>"$codex_md"
  fi
}

xml_escape() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

install_launchd() {
  local plist="$HOME/Library/LaunchAgents/$LABEL.plist" log="$HOME/Library/Logs/skills-sync.log"
  mkdir -p "$(dirname "$plist")" "$(dirname "$log")"
  cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>$(xml_escape "git -C '$repo' pull --ff-only && '$repo/tools/install'")</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>$(xml_escape "$PATH")</string>
  </dict>
  <key>StartInterval</key>
  <integer>21600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$(xml_escape "$log")</string>
  <key>StandardErrorPath</key>
  <string>$(xml_escape "$log")</string>
</dict>
</plist>
EOF
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$plist"
  echo "installed $plist, logging to $log"
}

# Runs "$@" with --yes, otherwise prints what it would do.
act() {
  local what=$1
  shift
  if [ "$yes" = 1 ]; then
    echo "$what"
    "$@"
  else
    echo "would $what"
  fi
}

remove_line() { grep -vxF "$2" "$1" >"$tmp/stripped" || true; cp "$tmp/stripped" "$1"; }

uninstall_plugin() {
  if [ "$2" = project ]; then (cd "$3" && claude plugin uninstall "$1" -s project)
  else claude plugin uninstall "$1" -s "$2"
  fi
}

# Removes what an older setup linked in (symlinks) and whatever blocks a desired target.
# Unmanaged files and directories that block nothing are the user's and stay.
clean_home() {
  local dir entry id scope path name old_line="@~/.claude/pstack-models.md"
  for dir in "$HOME/.agents/skills" "$HOME/.claude/skills" "$HOME/.claude/agents"; do
    [ -d "$dir" ] || continue
    for entry in "$dir"/* "$dir"/.[!.]*; do
      present "$entry" || continue
      managed "$entry" && continue
      # claude.ai manages this directory.
      [ "$entry" = "$HOME/.claude/skills/synced" ] && continue
      [ -L "$entry" ] && in_place "$entry" "$(readlink "$entry")" && continue
      if grep -qxF "$entry" "$tmp/targets"; then act "replace $entry" rm -rf "$entry"
      elif [ -L "$entry" ]; then act "remove $entry" rm -f "$entry"
      fi
    done
  done
  while IFS= read -r entry; do
    case "$entry" in "$HOME/.agents/skills/"* | "$HOME/.claude/skills/"* | "$HOME/.claude/agents/"*) continue ;; esac
    if present "$entry" && ! managed "$entry"; then act "replace $entry" rm -f "$entry"; fi
  done <"$tmp/targets"

  if command -v claude >/dev/null 2>&1; then
    claude plugin list --json 2>/dev/null |
      jq -r '.[] | select(.id | test("@(pstack-claude|mattpocock)$")) | [.id, .scope, (.projectPath // "")] | @tsv' |
      while IFS=$'\t' read -r id scope path; do
        act "uninstall Claude Code plugin $id ($scope scope)" uninstall_plugin "$id" "$scope" "$path" </dev/null
      done
    claude plugin marketplace list --json 2>/dev/null |
      jq -r '.[] | select(.name == "pstack-claude" or .name == "mattpocock") | .name' |
      while IFS= read -r name; do
        act "remove Claude Code marketplace $name" claude plugin marketplace remove "$name" </dev/null
      done
  fi

  if grep -qxF "$old_line" "$HOME/.claude/CLAUDE.md" 2>/dev/null; then
    act "remove the line '$old_line' from $HOME/.claude/CLAUDE.md" remove_line "$HOME/.claude/CLAUDE.md" "$old_line"
  fi
  if [ -f "$HOME/.claude/pstack-models.md" ]; then
    act "remove $HOME/.claude/pstack-models.md" rm -f "$HOME/.claude/pstack-models.md"
  fi
  if jq -e '.skills | type == "object"' "$HOME/.agents/.skill-lock.json" >/dev/null 2>&1; then
    act "remove the skills CLI lock $HOME/.agents/.skill-lock.json" rm -f "$HOME/.agents/.skill-lock.json"
  fi
}

if [ "$clean" = 1 ]; then
  clean_home
  if [ "$yes" = 0 ]; then
    echo "dry run: rerun with --clean --yes to apply, then install"
    exit 0
  fi
fi
install_links
install_instructions
if [ "$launchd" = 1 ]; then install_launchd; fi
echo "installed $(grep -c . "$manifest") links and generated files from $repo"
