#!/usr/bin/env bash
set -euo pipefail

install=$(cd "$(dirname "$0")" && pwd)/install
base=$(cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$base"' EXIT

check() {
  local msg=$1
  shift
  if "$@" >/dev/null 2>&1; then
    echo "ok: $msg"
  else
    echo "FAIL: $msg"
    exit 1
  fi
}

not() { ! "$@"; }
same() { [ "$1" = "$2" ] || { printf -- '--- expected\n%s\n--- actual\n%s\n' "$1" "$2" >&2; return 1; }; }
contains() { case "$2" in *"$1"*) return 0 ;; *) return 1 ;; esac; }
snapshot() { (cd "$1" && find . -print0 | sort -z | xargs -0 ls -ld | awk '{ $6 = $7 = $8 = ""; print }'); }

# A repo with two skills and one agent, and a stub `claude` that logs its plugin commands.
scenario() {
  local d="$base/$1"
  repo="$d/repo"
  home="$d/home"
  mkdir -p "$repo/tools" "$repo/skills/alpha" "$repo/skills/beta" "$repo/agents" "$repo/config" "$home" "$d/bin"
  cp "$install" "$repo/tools/install"
  printf -- '---\nname: alpha\n---\n' >"$repo/skills/alpha/SKILL.md"
  printf -- '---\nname: beta\n---\n' >"$repo/skills/beta/SKILL.md"
  cat >"$repo/agents/finder.md" <<'EOF'
---
name: finder
description: "Finds \"things\" fast"
model: sonnet
effort: max
permissionMode: readOnly
---

Find files under C:\work and say "done".

EOF
  printf 'models\n' >"$repo/config/pstack-models.md"
  printf 'Use the pr skill.\n' >"$repo/config/global-instructions.md"
  cat >"$d/bin/claude" <<EOF
#!/bin/sh
echo "\$*" >>"$d/claude.log"
case "\$*" in
  "plugin list --json") echo '[{"id":"pstack@pstack-claude","scope":"user"},{"id":"other@elsewhere","scope":"user"}]' ;;
  "plugin marketplace list --json") echo '[{"name":"pstack-claude"},{"name":"claude-plugins-official"}]' ;;
esac
EOF
  cat >"$d/bin/launchctl" <<EOF
#!/bin/sh
echo "\$1" >>"$d/launchctl.log"
[ "\$1" != print ]
EOF
  chmod +x "$d/bin/claude" "$d/bin/launchctl"
  stub_path="$d/bin:$PATH"
}

run() { HOME=$home PATH=$stub_path "$repo/tools/install" "$@"; }

scenario fresh
run >/dev/null
check "a skill links into ~/.agents/skills" same "$(readlink "$home/.agents/skills/alpha")" "$repo/skills/alpha"
check "links in ~/.claude/skills go through ~/.agents/skills" same "$(readlink "$home/.claude/skills/alpha")" "$home/.agents/skills/alpha"
check "an agent links into ~/.claude/agents" same "$(readlink "$home/.claude/agents/finder.md")" "$repo/agents/finder.md"
check "the model config links into ~/.agents" same "$(readlink "$home/.agents/pstack-models.md")" "$repo/config/pstack-models.md"
check "the codex agent maps fields the way codex's migration does" same "$(cat "$home/.codex/agents/finder.toml")" '# Generated by tools/install from the skills repo. Edits are overwritten.
name = "finder"
description = "Finds \"things\" fast"
model_reasoning_effort = "xhigh"
sandbox_mode = "read-only"
developer_instructions = """
Find files under C:\\work and say \"done\"."""'
check "CLAUDE.md includes the global instructions" same "$(cat "$home/.claude/CLAUDE.md")" "@$repo/config/global-instructions.md"
check "a managed block in ~/.codex/AGENTS.md holds the global instructions" same "$(cat "$home/.codex/AGENTS.md")" "<!-- BEGIN skills repo global instructions (managed by tools/install) -->
Use the pr skill.
<!-- END skills repo global instructions -->"

before=$(snapshot "$home")
run >/dev/null
check "a rerun changes nothing" same "$(snapshot "$home")" "$before"

printf 'Use the pr skill. Always.\n' >"$repo/config/global-instructions.md"
run >/dev/null
check "a rerun refreshes the managed block in place" same "$(cat "$home/.codex/AGENTS.md")" "<!-- BEGIN skills repo global instructions (managed by tools/install) -->
Use the pr skill. Always.
<!-- END skills repo global instructions -->"

rm -r "$repo/skills/beta" "$repo/agents/finder.md"
run >/dev/null
check "a skill removed from the repo is unlinked" not test -L "$home/.agents/skills/beta"
check "its ~/.claude/skills link is unlinked too" not test -L "$home/.claude/skills/beta"
check "a removed agent's codex file is deleted" not test -e "$home/.codex/agents/finder.toml"
check "skills still in the repo stay linked" test -L "$home/.agents/skills/alpha"

scenario existing
mkdir -p "$home/.agents/skills/alpha" "$home/.claude" "$home/.codex"
printf 'mine\n' >"$home/.agents/skills/alpha/SKILL.md"
printf 'my rules\n' >"$home/.claude/CLAUDE.md"
printf 'I have rules.\n' >"$home/.codex/AGENTS.md"
out=$(run 2>&1)
check "an unmanaged path is left alone" same "$(cat "$home/.agents/skills/alpha/SKILL.md")" "mine"
check "an unmanaged path gets a warning" contains "skipping $home/.agents/skills/alpha" "$out"
check "other skills still install" test -L "$home/.agents/skills/beta"
check "existing CLAUDE.md content is kept" same "$(cat "$home/.claude/CLAUDE.md")" "my rules

@$repo/config/global-instructions.md"
check "existing AGENTS.md content is kept" same "$(cat "$home/.codex/AGENTS.md")" "I have rules.

<!-- BEGIN skills repo global instructions (managed by tools/install) -->
Use the pr skill.
<!-- END skills repo global instructions -->"

printf 'unrelated\n' >"$home/.claude/agents/mine.md"
ln -s "$base/existing/gone.md" "$home/.claude/agents/stray.md"
mkdir -p "$home/.claude/plugins/cache/p" "$home/.claude/skills" "$base/existing/dotfiles/df"
printf 'p\n' >"$home/.claude/plugins/cache/p/plugged.md"
ln -s "$home/.claude/plugins/cache/p/plugged.md" "$home/.claude/agents/plugged.md"
ln -s "$base/existing/gone" "$home/.claude/skills/synced"
mkdir -p "$home/.agents/skills/oldcli" "$home/.agents/skills/handmade"
ln -s ../../.agents/skills/oldcli "$home/.claude/skills/oldcli"
ln -s ../../.agents/skills/handmade "$home/.claude/skills/handmade"
ln -s "$base/existing/dotfiles/df" "$home/.agents/skills/df"
printf '{"skills":{"oldcli":{},"df":{}}}\n' >"$base/existing/dotfiles/skill-lock.json"
ln -s "$base/existing/dotfiles/skill-lock.json" "$home/.agents/.skill-lock.json"
printf '@~/.claude/pstack-models.md\nmy rules\n' >"$home/.claude/CLAUDE.md"
printf 'old\n' >"$home/.claude/pstack-models.md"
before=$(snapshot "$home")
out=$(run --clean)
check "a clean dry run changes nothing" same "$(snapshot "$home")" "$before"
check "a clean dry run lists exactly the stale links and skills CLI copies" same "$(grep '^would remove /' <<<"$out" | grep -v pstack-models)" "would remove $home/.agents/skills/oldcli (installed by the skills CLI)
would remove $home/.claude/skills/oldcli
would remove $home/.claude/agents/plugged.md
would remove $home/.claude/agents/stray.md"
check "a clean dry run lists the unmanaged skill to replace" contains "would replace $home/.agents/skills/alpha" "$out"
check "a clean dry run lists the pstack plugin" contains "would uninstall Claude Code plugin pstack@pstack-claude (user scope)" "$out"
check "a clean dry run lists the pstack marketplace" contains "would remove Claude Code marketplace pstack-claude" "$out"
check "a clean dry run leaves unrelated plugins out" not contains "other@elsewhere" "$out"
run --clean --yes >/dev/null
check "clean replaces the unmanaged skill with a link" same "$(readlink "$home/.agents/skills/alpha")" "$repo/skills/alpha"
check "clean removes dangling links" not test -L "$home/.claude/agents/stray.md"
check "clean removes links into a plugin cache" not test -L "$home/.claude/agents/plugged.md"
check "clean removes skills CLI copies" not test -e "$home/.agents/skills/oldcli"
check "clean removes links to skills CLI copies" not test -L "$home/.claude/skills/oldcli"
check "clean keeps the user's own agents" same "$(cat "$home/.claude/agents/mine.md")" "unrelated"
check "clean keeps the user's own skills" test -d "$home/.agents/skills/handmade"
check "clean keeps links to the user's own skills" test -L "$home/.claude/skills/handmade"
check "clean keeps links into the user's dotfiles" test -L "$home/.agents/skills/df"
check "clean never touches claude.ai's synced skills" test -L "$home/.claude/skills/synced"
check "clean unlinks the skills CLI lock" not test -L "$home/.agents/.skill-lock.json"
check "clean leaves the lock link's target alone" test -f "$base/existing/dotfiles/skill-lock.json"
check "clean drops the old model config include" same "$(cat "$home/.claude/CLAUDE.md")" "my rules

@$repo/config/global-instructions.md"
check "clean deletes the old model config" not test -e "$home/.claude/pstack-models.md"
check "clean runs the plugin removals" contains "plugin uninstall pstack@pstack-claude -s user
plugin marketplace list --json
plugin marketplace remove pstack-claude" "$(cat "$base/existing/claude.log")"

scenario frontmatter
printf -- '---\r\nname: crlf\r\ndescription: "Ends lines with CRLF"\r\n---\r\nBody.\r\n' >"$repo/agents/crlf.md"
cat >"$repo/agents/folded.md" <<'EOF'
---
name: folded
description: >-
  Folds these
  two lines.

  Keeps a paragraph.
notes: |
  ignored
---
Body.
EOF
cat >"$repo/agents/literal.md" <<'EOF'
---
name: literal
description: |
  line one
  line two
---
Body.
EOF
run >/dev/null 2>&1
check "a CRLF agent renders to codex" same "$(sed -n '2,3p' "$home/.codex/agents/crlf.toml")" 'name = "crlf"
description = "Ends lines with CRLF"'
check "a folded description joins its lines" same "$(sed -n 3p "$home/.codex/agents/folded.toml")" 'description = "Folds these two lines.\nKeeps a paragraph."'
check "a literal description keeps its newlines" same "$(sed -n 3p "$home/.codex/agents/literal.toml")" 'description = "line one\nline two"'

scenario launchd
run --launchd >/dev/null
run --launchd >/dev/null
check "a --launchd rerun boots the old job out before bootstrapping" same "$(cat "$base/launchd/launchctl.log")" "bootout
print
bootstrap
bootout
print
bootstrap"
plist=$home/Library/LaunchAgents/com.sunnshiine.skills-sync.plist
check "the LaunchAgent runs install --update" same "$(plutil -extract ProgramArguments.0 raw -o - "$plist") $(plutil -extract ProgramArguments.1 raw -o - "$plist")" "$repo/tools/install --update"

scenario update
git init --quiet -b main "$repo"
git -C "$repo" add -A
git -C "$repo" -c user.email=t@example.com -c user.name=t commit --quiet -m init
git clone --quiet "$repo" "$base/update/clone"
clone=$base/update/clone
mkdir -p "$repo/skills/gamma"
printf -- '---\nname: gamma\n---\n' >"$repo/skills/gamma/SKILL.md"
git -C "$repo" add -A
git -C "$repo" -c user.email=t@example.com -c user.name=t commit --quiet -m gamma
out=$(HOME=$home PATH=$stub_path "$clone/tools/install" --update 2>&1)
check "--update pulls and installs the new skill" same "$(readlink "$home/.agents/skills/gamma")" "$clone/skills/gamma"
check "--update timestamps every log line" not grep -vE '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} ' <<<"$out"
git -C "$clone" switch --quiet -c topic
git -C "$repo" rm --quiet -r skills/gamma
git -C "$repo" -c user.email=t@example.com -c user.name=t commit --quiet -m "drop gamma"
out=$(HOME=$home PATH=$stub_path "$clone/tools/install" --update 2>&1)
check "--update off main logs that it skipped" contains "skipping update: $clone is on topic, not main" "$out"
check "--update off main leaves the clone alone" test -d "$clone/skills/gamma"

scenario unterminated
mkdir -p "$home/.codex"
printf 'before\n<!-- BEGIN skills repo global instructions (managed by tools/install) -->\nold\nmy later rules\n' >"$home/.codex/AGENTS.md"
before=$(cat "$home/.codex/AGENTS.md")
out=$(run 2>&1) && status=0 || status=$?
check "a managed block with no END marker fails the install" test "$status" = 1
check "a managed block with no END marker is named in the error" contains "no '<!-- END skills repo global instructions -->'" "$out"
check "a managed block with no END marker keeps the file intact" same "$(cat "$home/.codex/AGENTS.md")" "$before"

echo "all checks passed"
