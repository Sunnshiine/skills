#!/usr/bin/env bash
set -euo pipefail

# Exit codes: 0 done, 1 error, 2 usage, 3 merge conflict left in the working tree.
EXIT_CONFLICT=3
BLOCK_BEGIN='<!-- BEGIN renames (generated by tools/sync; edits here are overwritten) -->'
BLOCK_END='<!-- END renames -->'

usage() {
  echo "usage: tools/sync (--all | <source> [<ref>]) [--no-merge]" >&2
  exit 2
}

all=0
name=""
ref_arg=""
do_merge=1
for arg in "$@"; do
  case "$arg" in
    --all) all=1 ;;
    --no-merge) do_merge=0 ;;
    -*) usage ;;
    *)
      if [ -z "$name" ]; then name="$arg"
      elif [ -z "$ref_arg" ]; then ref_arg="$arg"
      else usage
      fi
      ;;
  esac
done
if [ "$all" = 1 ]; then [ -z "$name" ] || usage; else [ -n "$name" ] || usage; fi

root=$(git rev-parse --show-toplevel)
registry="$root/sources.json"
[ -f "$registry" ] || { echo "no sources.json at $registry" >&2; exit 1; }

sources=()
while IFS= read -r s; do sources+=("$s"); done < <(jq -r '.sources[].name' "$registry")

field() { jq -r --arg s "$1" --arg f "$2" '.sources[] | select(.name == $s) | .[$f]' "$registry"; }
list() { jq -r --arg s "$1" --arg f "$2" '.sources[] | select(.name == $s) | .[$f][]?' "$registry"; }

if [ "$all" = 1 ]; then
  # Lowest precedence first: a source renaming a customized item away from a bare name merges
  # before the higher-precedence source that claims the name, so git carries the edit along.
  targets=()
  for s in "${sources[@]}"; do targets=("$s" ${targets[@]+"${targets[@]}"}); done
else
  if [ -z "$(field "$name" name)" ]; then
    { echo "unknown source: $name"; echo "known sources:"; printf '  %s\n' "${sources[@]}"; } >&2
    exit 1
  fi
  targets=("$name")
fi

if [ "$do_merge" = 1 ]; then
  if [ -e "$(git -C "$root" rev-parse --git-path MERGE_HEAD)" ]; then
    echo "a merge is already in progress" >&2
    exit 1
  fi
  if ! git -C "$root" diff --quiet HEAD --; then
    echo "working tree has uncommitted changes to tracked files" >&2
    exit 1
  fi
fi

tmp=$(mktemp -d)
cleanup() {
  for wt in "$tmp"/wt/*; do
    [ -e "$wt" ] && git -C "$root" worktree remove --force "$wt" >/dev/null 2>&1
  done
  rm -rf "$tmp"
  git -C "$root" worktree prune >/dev/null 2>&1 || true
}
trap cleanup EXIT
git -C "$root" worktree prune
mkdir -p "$tmp/up" "$tmp/plan" "$tmp/wt"

# Lists "<kind>\t<bare name>\t<upstream path>" for every item a source selects.
plan_source() {
  local s=$1 up=$2 at=$3 pat p ex excluded matched
  local excludes=()
  while IFS= read -r ex; do excludes+=("$ex"); done < <(list "$s" exclude)
  for kind in skill agent; do
    while IFS= read -r pat; do
      matched=0
      while IFS= read -r p; do
        if [ "$kind" = skill ]; then [ -f "$up/$p/SKILL.md" ] || continue
        else case "$p" in *.md) [ -f "$up/$p" ] || continue ;; *) continue ;; esac
        fi
        matched=1
        excluded=0
        for ex in ${excludes[@]+"${excludes[@]}"}; do
          # shellcheck disable=SC2053
          [[ "$p" == $ex ]] && excluded=1
        done
        [ "$excluded" = 1 ] && continue
        printf '%s\t%s\t%s\n' "$kind" "$(basename "$p" .md)" "$p"
      done < <(cd "$up" && shopt -s nullglob && for p in $pat; do echo "$p"; done)
      [ "$matched" = 1 ] || { echo "$s: '$pat' matches no $kind in $at" >&2; return 1; }
    done < <(list "$s" "${kind}s")
  done
  p=$(field "$s" license)
  if [ "$p" != null ]; then
    [ -f "$up/$p" ] || { echo "$s: license '$p' does not exist in $at" >&2; return 1; }
    printf 'license\tLICENSE\t%s\n' "$p"
  fi
}

# Inverse of the renames block: the bare name a renamed item had upstream.
bare_name() {
  local kind=$1 final=$2 s=$3
  [ -f "$root/CUSTOMIZATIONS.md" ] &&
    awk -F'`' -v f="$final" -v t=": $s $kind " '
      $1 == "- " && $2 == f && $3 == t { print $4; found = 1; exit }
      END { exit !found }
    ' "$root/CUSTOMIZATIONS.md" ||
    echo "$final"
}

vendor_ref() {
  local ref
  for ref in "refs/heads/vendor/$1" "refs/remotes/origin/vendor/$1"; do
    if git -C "$root" rev-parse --verify --quiet "$ref^{commit}" >/dev/null; then echo "$ref"; return 0; fi
  done
  return 1
}

# Lists "<kind>\t<name>" for every skill and agent in a tree-ish.
tree_items() {
  git -C "$root" ls-tree --name-only "$1" skills/ agents/ | while IFS= read -r p; do
    case "$p" in
      skills/*) printf 'skill\t%s\n' "${p#skills/}" ;;
      agents/*.md) printf 'agent\t%s\n' "$(basename "$p" .md)" ;;
    esac
  done
}

# The items a source last vendored, for computing collisions when its upstream cannot be read.
vendored_items() {
  local s=$1 ref kind final
  ref=$(vendor_ref "$s") || { echo "$s: no vendor/$s branch to fall back on" >&2; return 0; }
  tree_items "$ref" | while IFS=$'\t' read -r kind final; do
    printf '%s\t%s\t-\n' "$kind" "$(bare_name "$kind" "$final" "$s")"
  done
}

resolve_upstream() {
  local s=$1 url ref up sha dupes
  url=$(field "$s" url)
  ref=$(field "$s" ref)
  [ "$s" = "$name" ] && [ -n "$ref_arg" ] && ref=$ref_arg
  up="$tmp/up/$s"
  git clone --quiet --filter=blob:none --no-checkout "$url" "$up" || return 1
  sha=$(git -C "$up" rev-parse --verify --quiet "${ref}^{commit}") ||
    { echo "cannot resolve ref '$ref' in $url" >&2; return 1; }
  git -C "$up" checkout --quiet --detach "$sha" || return 1
  rm -rf "$up/.git"
  echo "$sha" >"$tmp/plan/$s.sha"
  plan_source "$s" "$up" "$url@$sha" >"$tmp/plan/$s.items" || return 1
  dupes=$(cut -f1,2 "$tmp/plan/$s.items" | sort | uniq -d)
  [ -z "$dupes" ] || { echo "$s selects two items with the same name: $dupes" >&2; return 1; }
}

# Collision renames depend on every source, so all are resolved even for a single-source sync.
# A source whose upstream fails falls back to its vendor branch, so only that source's sync fails.
failed=()
for s in "${sources[@]}"; do
  if ! resolve_upstream "$s"; then
    failed+=("$s")
    vendored_items "$s" >"$tmp/plan/$s.items"
  fi
done
is_failed() { local f; for f in ${failed[@]+"${failed[@]}"}; do [ "$f" = "$1" ] && return 0; done; return 1; }
if [ "$all" = 0 ] && is_failed "$name"; then exit 1; fi

# Earlier sources keep bare names; a later colliding item takes its source's rename_prefix.
: >"$tmp/plan/taken"
: >"$tmp/plan/renames"
for s in "${sources[@]}"; do
  prefix=$(field "$s" rename_prefix)
  : >"$tmp/plan/$s.final"
  while IFS=$'\t' read -r kind bare rel; do
    final=$bare
    if [ "$kind" != license ]; then
      owner=$(awk -F'\t' -v k="$kind" -v n="$bare" '$1 == k && $2 == n { print $3 }' "$tmp/plan/taken")
      if [ -n "$owner" ]; then
        final="$prefix$bare"
        if awk -F'\t' -v k="$kind" -v n="$final" '$1 == k && $2 == n { f = 1 } END { exit !f }' "$tmp/plan/taken"; then
          echo "$s: $kind '$bare' collides with $owner and its rename '$final' is taken too" >&2
          exit 1
        fi
        printf '%s\t%s\t%s\t%s\t%s\n' "$kind" "$final" "$bare" "$s" "$owner" >>"$tmp/plan/renames"
      fi
      printf '%s\t%s\t%s\n' "$kind" "$final" "$s" >>"$tmp/plan/taken"
    fi
    printf '%s\t%s\t%s\t%s\n' "$kind" "$final" "$bare" "$rel" >>"$tmp/plan/$s.final"
  done <"$tmp/plan/$s.items"
done

set_frontmatter_name() {
  local file=$1 new=$2
  awk -v n="$new" '
    NR == 1 && $0 == "---" { fm = 1; print; next }
    fm && $0 == "---" { fm = 0 }
    fm && !done && /^name:/ { print "name: " n; done = 1; next }
    { print }
  ' "$file" >"$file.tmp"
  mv "$file.tmp" "$file"
}

checkout_vendor() {
  local branch=$1 wt=$2
  if git -C "$root" remote get-url origin >/dev/null 2>&1 &&
     git -C "$root" fetch --quiet origin "+refs/heads/$branch:refs/remotes/origin/$branch" 2>/dev/null; then
    if ! git -C "$root" show-ref --verify --quiet "refs/heads/$branch" ||
       git -C "$root" merge-base --is-ancestor "$branch" "origin/$branch"; then
      git -C "$root" branch --quiet -f "$branch" "origin/$branch"
    elif ! git -C "$root" merge-base --is-ancestor "origin/$branch" "$branch"; then
      echo "$branch has diverged from origin/$branch" >&2
      return 1
    fi
  fi
  if git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$root" worktree add --quiet "$wt" "$branch"
  else
    git -C "$root" worktree add --quiet --orphan -b "$branch" "$wt"
  fi
}

# Lists "<old>\t<new>" for each item whose name changed on the vendor branch, so its
# CUSTOMIZATIONS.md heading can follow it.
record_moves() {
  local s=$1 branch=$2 prefix kind final bare rel other
  : >"$tmp/plan/$s.moves"
  git -C "$root" rev-parse --verify --quiet "$branch^{commit}" >/dev/null || return 0
  tree_items "$branch" >"$tmp/plan/$s.old"
  prefix=$(field "$s" rename_prefix)
  while IFS=$'\t' read -r kind final bare rel; do
    [ "$kind" = license ] && continue
    if [ "$final" = "$bare" ]; then other="$prefix$bare"; else other=$bare; fi
    if grep -qxF "$kind"$'\t'"$other" "$tmp/plan/$s.old" && ! grep -qxF "$kind"$'\t'"$final" "$tmp/plan/$s.old"; then
      printf '%s\t%s\n' "$other" "$final" >>"$tmp/plan/$s.moves"
    fi
  done <"$tmp/plan/$s.final"
}

move_headings() {
  local s=$1 file="$root/CUSTOMIZATIONS.md"
  [ -s "$tmp/plan/$s.moves" ] && [ -f "$file" ] || return 0
  awk -F'\t' '
    NR == FNR { to["## " $1] = "## " $2; next }
    $0 in to { $0 = to[$0] }
    { print }
  ' "$tmp/plan/$s.moves" "$file" >"$file.tmp"
  mv "$file.tmp" "$file"
  git -C "$root" add CUSTOMIZATIONS.md
}

snapshot() {
  local s=$1 branch="vendor/$1" wt="$tmp/wt/$1" up="$tmp/up/$1"
  local url sha kind final bare rel
  url=$(field "$s" url)
  sha=$(cat "$tmp/plan/$s.sha")
  checkout_vendor "$branch" "$wt"
  record_moves "$s" "$branch"
  git -C "$wt" rm -rq --ignore-unmatch -- .
  find "$wt" -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf {} +
  while IFS=$'\t' read -r kind final bare rel; do
    case "$kind" in
      skill)
        mkdir -p "$wt/skills"
        cp -R "$up/$rel" "$wt/skills/$final"
        [ "$final" = "$bare" ] || set_frontmatter_name "$wt/skills/$final/SKILL.md" "$final"
        ;;
      agent)
        mkdir -p "$wt/agents"
        cp "$up/$rel" "$wt/agents/$final.md"
        [ "$final" = "$bare" ] || set_frontmatter_name "$wt/agents/$final.md" "$final"
        ;;
      license)
        mkdir -p "$wt/licenses/$s"
        cp "$up/$rel" "$wt/licenses/$s/LICENSE"
        ;;
    esac
  done <"$tmp/plan/$s.final"
  git -C "$wt" add -A
  if [ -n "$(git -C "$wt" status --porcelain)" ]; then
    git -C "$wt" commit --quiet -m "vendor($s): $url@$sha"
    echo "$branch now holds $url@$sha"
  else
    echo "$branch already matches $url@$sha"
  fi
  git -C "$root" worktree remove --force "$wt"
  if git -C "$root" remote get-url origin >/dev/null 2>&1; then
    git -C "$root" push --quiet origin "$branch"
  fi
}

merge_vendor() {
  local s=$1 branch="vendor/$1" sha
  sha=$(cat "$tmp/plan/$s.sha")
  if git -C "$root" merge-base --is-ancestor "$branch" HEAD; then
    echo "$branch is already merged"
    return 0
  fi
  if ! git -C "$root" merge --no-ff --no-commit --allow-unrelated-histories \
       -m "sync($s): merge upstream ${sha:0:7}" "$branch" 2>"$tmp/merge.err" &&
     [ -z "$(git -C "$root" diff --name-only --diff-filter=U)" ]; then
    cat "$tmp/merge.err" >&2
    echo "sync($s): merge failed" >&2
    exit 1
  fi
  move_headings "$s"
  if [ -n "$(git -C "$root" diff --name-only --diff-filter=U)" ]; then
    echo "sync($s): conflicts left in place. resolve, git add, git commit, or git merge --abort" >&2
    exit "$EXIT_CONFLICT"
  fi
  git -C "$root" commit --quiet --no-edit
}

renames_block() {
  echo "$BLOCK_BEGIN"
  if [ -s "$tmp/plan/renames" ]; then
    echo "## Renamed by sync"
    sort -t$'\t' -k2,2 "$tmp/plan/renames" | while IFS=$'\t' read -r kind final bare s owner; do
      echo "- \`$final\`: $s $kind \`$bare\`, renamed because $owner has one with that name."
    done
  fi
  echo "$BLOCK_END"
}

record_renames() {
  local file="$root/CUSTOMIZATIONS.md"
  renames_block >"$tmp/block"
  if [ ! -f "$file" ]; then
    printf '# Customizations\n\n' >"$file"
    cat "$tmp/block" >>"$file"
  elif grep -qxF "$BLOCK_BEGIN" "$file"; then
    grep -qxF "$BLOCK_END" "$file" || { echo "$file has '$BLOCK_BEGIN' but no '$BLOCK_END'" >&2; exit 1; }
    awk -v b="$BLOCK_BEGIN" -v e="$BLOCK_END" -v blk="$tmp/block" '
      $0 == b { while ((getline line < blk) > 0) print line; skip = 1; next }
      $0 == e { skip = 0; next }
      !skip { print }
    ' "$file" >"$file.tmp"
    mv "$file.tmp" "$file"
  else
    { echo; cat "$tmp/block"; } >>"$file"
  fi
  if [ -n "$(git -C "$root" status --porcelain -- CUSTOMIZATIONS.md)" ]; then
    git -C "$root" add CUSTOMIZATIONS.md
    git -C "$root" commit --quiet -m "sync: update rename log in CUSTOMIZATIONS.md"
  fi
}

for s in "${targets[@]}"; do
  if is_failed "$s"; then
    echo "$s: skipped, its upstream could not be read" >&2
    continue
  fi
  snapshot "$s"
  if [ "$do_merge" = 1 ]; then merge_vendor "$s"; fi
done

if [ "$do_merge" = 1 ]; then
  record_renames
else
  echo "preview incoming changes with: git diff HEAD...vendor/<source>"
fi
if [ "$all" = 1 ] && [ -n "${failed[*]-}" ]; then exit 1; fi
