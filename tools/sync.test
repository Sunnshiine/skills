#!/usr/bin/env bash
set -euo pipefail

sync=$(cd "$(dirname "$0")" && pwd)/sync
base=$(mktemp -d)
trap 'rm -rf "$base"' EXIT

check() {
  local msg=$1
  shift
  if "$@" >/dev/null 2>&1; then
    echo "ok: $msg"
  else
    echo "FAIL: $msg"
    exit 1
  fi
}

not() { ! "$@"; }
same() { [ "$1" = "$2" ] || { printf -- '--- expected\n%s\n--- actual\n%s\n' "$1" "$2" >&2; return 1; }; }
contains() { case "$2" in *"$1"*) return 0 ;; *) return 1 ;; esac; }
worktrees() { git -C "$1" worktree list | wc -l | tr -d ' '; }
tree() { git -C "$1" ls-tree -r --name-only "$2"; }
commit_in() { git -C "$1" add -A && git -C "$1" commit --quiet -m "$2"; }
sync_in() { local d=$1; shift; (cd "$d" && "$sync" "$@"); }
skill() { mkdir -p "$1"; printf -- '---\nname: %s\ndescription: %s\n---\n%s' "$2" "$3" "$4" >"$1/SKILL.md"; }

new_repo() {
  git init --quiet -b main "$1"
  git -C "$1" config user.email sync@example.com
  git -C "$1" config user.name "sync test"
  git -C "$1" config commit.gpgsign false
  git -C "$1" config uploadpack.allowFilter true
}

# alpha outranks beta; both ship a skill named tdd and one named proto.
scenario() {
  local d="$base/$1"
  new_repo "$d/alpha"
  skill "$d/alpha/skills/tdd" tdd "alpha tdd" $'alpha tdd body\n'
  skill "$d/alpha/skills/proto" proto "alpha proto" $'alpha proto body\n'
  mkdir -p "$d/alpha/agents"
  printf -- '---\nname: helper\ndescription: helps\n---\nhelp\n' >"$d/alpha/agents/helper.md"
  printf 'alpha license\n' >"$d/alpha/LICENSE"
  printf 'not selected\n' >"$d/alpha/notes.md"
  commit_in "$d/alpha" "alpha v1"

  new_repo "$d/beta"
  skill "$d/beta/skills/eng/tdd" tdd "beta tdd" $'beta tdd body\n'
  skill "$d/beta/skills/eng/proto" proto "beta proto" $'beta proto body\n'
  skill "$d/beta/skills/eng/diag" diag "beta diag" $'one\ntwo\nthree\n'
  skill "$d/beta/skills/misc/junk" junk "junk" $'junk\n'
  printf 'not a skill\n' >"$d/beta/skills/eng/README.md"
  printf 'beta license\n' >"$d/beta/LICENSE"
  commit_in "$d/beta" "beta v1"

  new_repo "$d/repo"
  cat >"$d/repo/sources.json" <<EOF
{
  "sources": [
    {"name": "alpha", "url": "file://$d/alpha", "ref": "main", "rename_prefix": "a-",
     "skills": ["skills/*"], "exclude": [], "agents": ["agents/*.md"], "license": "LICENSE"},
    {"name": "beta", "url": "file://$d/beta", "ref": "main", "rename_prefix": "b-",
     "skills": ["skills/eng/*"], "exclude": ["skills/eng/proto"], "agents": [], "license": "LICENSE"},
    {"name": "broken", "url": "file://$d/beta", "ref": "main", "rename_prefix": "x-",
     "skills": ["skills/nope"], "exclude": [], "agents": [], "license": null}
  ]
}
EOF
  printf '# repo\n' >"$d/repo/README.md"
  commit_in "$d/repo" "repo init"
}

drop_broken() {
  jq '.sources |= map(select(.name != "broken"))' "$1/sources.json" >"$1/sources.json.tmp"
  mv "$1/sources.json.tmp" "$1/sources.json"
  commit_in "$1" "drop broken source"
}

scenario layout
r=$base/layout/repo
drop_broken "$r"
sync_in "$r" --all >/dev/null
check "main holds every selected item, flat, with renames applied" same "$(tree "$r" main)" "CUSTOMIZATIONS.md
README.md
agents/helper.md
licenses/alpha/LICENSE
licenses/beta/LICENSE
skills/b-tdd/SKILL.md
skills/diag/SKILL.md
skills/proto/SKILL.md
skills/tdd/SKILL.md
sources.json"
check "a vendor branch holds only its own source's transformed files" same "$(tree "$r" vendor/beta)" "licenses/beta/LICENSE
skills/b-tdd/SKILL.md
skills/diag/SKILL.md"
check "the higher-precedence source keeps the bare name" same "$(cat "$r/skills/tdd/SKILL.md")" "---
name: tdd
description: alpha tdd
---
alpha tdd body"
check "a colliding lower-precedence skill is renamed in its frontmatter too" same "$(cat "$r/skills/b-tdd/SKILL.md")" "---
name: b-tdd
description: beta tdd
---
beta tdd body"
check "an explicit exclude beats a rename" not test -e "$r/skills/b-proto"
check "renames are logged in CUSTOMIZATIONS.md" same "$(cat "$r/CUSTOMIZATIONS.md")" "# Customizations

<!-- BEGIN renames (generated by tools/sync; edits here are overwritten) -->
## Renamed by sync
- \`b-tdd\`: beta skill \`tdd\`, renamed because alpha has one with that name.
<!-- END renames -->"
check "vendor commits record the upstream sha" contains "file://$base/layout/alpha@$(git -C "$base/layout/alpha" rev-parse HEAD)" "$(git -C "$r" log -1 --format=%s vendor/alpha)"
check "vendor branches are orphans" test -z "$(git -C "$r" log --format=%P -1 vendor/alpha)"
check "no leftover worktree registrations" test "$(worktrees "$r")" = 1

main_before=$(git -C "$r" rev-parse main)
vendor_before=$(git -C "$r" rev-parse vendor/alpha)
printf 'still not selected\n' >"$base/layout/alpha/notes.md"
commit_in "$base/layout/alpha" "alpha touches an unselected file"
sync_in "$r" --all >/dev/null
check "an unchanged transformed tree adds no vendor commit" same "$(git -C "$r" rev-parse vendor/alpha)" "$vendor_before"
check "an unchanged transformed tree adds no commit to main" same "$(git -C "$r" rev-parse main)" "$main_before"

scenario single
r=$base/single/repo
drop_broken "$r"
sync_in "$r" beta >/dev/null
check "a single-source sync still renames against every other source" same "$(tree "$r" vendor/beta)" "licenses/beta/LICENSE
skills/b-tdd/SKILL.md
skills/diag/SKILL.md"
check "a single-source sync leaves other vendor branches alone" not git -C "$r" rev-parse --verify --quiet vendor/alpha

scenario evolve
r=$base/evolve/repo
b=$base/evolve/beta
drop_broken "$r"
sync_in "$r" --all >/dev/null
skill "$r/skills/diag" diag "beta diag" $'one\ntwo\nmy three\n'
commit_in "$r" "customize diag"
skill "$b/skills/eng/diag" diag "beta diag" $'upstream one\ntwo\nthree\n'
git -C "$b" rm --quiet -r skills/eng/tdd
commit_in "$b" "beta v2"
sync_in "$r" beta >/dev/null
check "a user edit survives an upstream change to the same file" same "$(cat "$r/skills/diag/SKILL.md")" "---
name: diag
description: beta diag
---
upstream one
two
my three"
check "an upstream deletion flows through to main" not test -e "$r/skills/b-tdd"
check "a rename that no longer applies leaves the log" same "$(cat "$r/CUSTOMIZATIONS.md")" "# Customizations

<!-- BEGIN renames (generated by tools/sync; edits here are overwritten) -->
<!-- END renames -->"

scenario conflict
r=$base/conflict/repo
b=$base/conflict/beta
drop_broken "$r"
sync_in "$r" --all >/dev/null
skill "$r/skills/diag" diag "beta diag" $'one\nmine\nthree\n'
commit_in "$r" "customize diag"
skill "$b/skills/eng/diag" diag "beta diag" $'one\ntheirs\nthree\n'
commit_in "$b" "beta v2"
sync_in "$r" beta >/dev/null 2>&1 && status=0 || status=$?
check "overlapping edits exit with the conflict code 3" test "$status" = 3
check "overlapping edits leave a conflicted merge in place" test -f "$r/.git/MERGE_HEAD"
check "no leftover worktree registrations after a conflict" test "$(worktrees "$r")" = 1

scenario missing
r=$base/missing/repo
out=$(sync_in "$r" broken 2>&1) && status=0 || status=$?
check "an include that matches nothing exits 1" test "$status" = 1
check "an include that matches nothing is named in the error" contains "'skills/nope' matches no skill" "$out"
sync_in "$r" alpha >/dev/null 2>&1 && status=0 || status=$?
check "a broken source does not fail another source's sync" test "$status" = 0
sync_in "$r" --all >/dev/null 2>&1 && status=0 || status=$?
check "--all exits 1 when one source is broken" test "$status" = 1
check "--all still merges every working source" same "$(tree "$r" main | grep '^skills/')" "skills/b-tdd/SKILL.md
skills/diag/SKILL.md
skills/proto/SKILL.md
skills/tdd/SKILL.md"

scenario offline
r=$base/offline/repo
drop_broken "$r"
sync_in "$r" --all >/dev/null
mv "$base/offline/alpha" "$base/offline/alpha-gone"
sync_in "$r" beta >/dev/null 2>&1 && status=0 || status=$?
check "an unreachable source does not fail another source's sync" test "$status" = 0
check "an unreachable source's vendor branch still drives renames" same "$(tree "$r" vendor/beta)" "licenses/beta/LICENSE
skills/b-tdd/SKILL.md
skills/diag/SKILL.md"
check "an unreachable source keeps its renames in the log" contains "- \`b-tdd\`: beta skill \`tdd\`, renamed because alpha has one with that name." "$(cat "$r/CUSTOMIZATIONS.md")"

scenario collide
r=$base/collide/repo
a=$base/collide/alpha
b=$base/collide/beta
drop_broken "$r"
skill "$b/skills/eng/foo" foo "beta foo" $'l1\nl2\nl3\nl4\nl5\n'
commit_in "$b" "beta adds foo"
sync_in "$r" --all >/dev/null
skill "$r/skills/foo" foo "beta foo" $'l1\nl2\nmy l3\nl4\nl5\n'
printf '# Customizations\n\n## foo\n- Rewrote l3.\n\n' >"$r/CUSTOMIZATIONS.md.new"
sed -n '/^<!-- BEGIN/,$p' "$r/CUSTOMIZATIONS.md" >>"$r/CUSTOMIZATIONS.md.new"
mv "$r/CUSTOMIZATIONS.md.new" "$r/CUSTOMIZATIONS.md"
commit_in "$r" "customize foo"
skill "$a/skills/foo" foo "alpha foo" $'alpha foo body\n'
commit_in "$a" "alpha adds foo"
sync_in "$r" --all >/dev/null 2>&1 && status=0 || status=$?
check "a new collision with a customized skill merges cleanly" test "$status" = 0
check "the customized skill keeps its edit under its new name" same "$(cat "$r/skills/b-foo/SKILL.md")" "---
name: b-foo
description: beta foo
---
l1
l2
my l3
l4
l5"
check "the higher-precedence source takes the bare name" same "$(cat "$r/skills/foo/SKILL.md")" "---
name: foo
description: alpha foo
---
alpha foo body"
check "the customization heading follows the rename" same "$(sed -n '1,5p' "$r/CUSTOMIZATIONS.md")" "# Customizations

## b-foo
- Rewrote l3."
check "the merge commit names its source" same "$(git -C "$r" log --format=%s --merges -1 --first-parent HEAD~1)" "sync(alpha): merge upstream $(git -C "$a" rev-parse --short=7 HEAD)"

scenario crlf
r=$base/crlf/repo
b=$base/crlf/beta
drop_broken "$r"
printf -- '---\r\nname: tdd\r\ndescription: beta tdd\r\n---\r\nbody\r\n' >"$b/skills/eng/tdd/SKILL.md"
commit_in "$b" "beta uses CRLF"
sync_in "$r" beta >/dev/null
check "a rename rewrites CRLF frontmatter and keeps its line endings" same "$(od -c "$r/skills/b-tdd/SKILL.md")" "$(printf -- '---\r\nname: b-tdd\r\ndescription: beta tdd\r\n---\r\nbody\r\n' | od -c)"

scenario nomerge
r=$base/nomerge/repo
drop_broken "$r"
main_before=$(git -C "$r" rev-parse main)
sync_in "$r" alpha --no-merge >/dev/null
check "--no-merge advances the vendor branch" git -C "$r" rev-parse --verify vendor/alpha
check "--no-merge leaves the current branch untouched" same "$(git -C "$r" rev-parse main)" "$main_before"

echo "all checks passed"
